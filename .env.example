# Flask session signing. Generate a real value for any shared deployment.
FLASK_SECRET_KEY=change-me-to-a-long-random-string

# SQLite database path (relative to project root)
DB_PATH=reconai.db

# LLM backend: none | ollama | openai (any OpenAI-compatible endpoint)
LLM_PROVIDER=none
LLM_MODEL=llama3.1

# Ollama (local)
OLLAMA_URL=http://localhost:11434

# OpenAI-compatible / OpenRouter (cloud)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_TIMEOUT=60

# Safety: keep false unless you are assessing a lab you control
ALLOW_PRIVATE_TARGETS=false

# Timeouts (seconds) and concurrency
HTTP_TIMEOUT=10
DNS_TIMEOUT=3
WHOIS_TIMEOUT=15
SCAN_WORKERS=2
MAX_SUBDOMAIN_WORKERS=8

# Scan-creation requests allowed per client IP per minute
RATE_LIMIT_PER_MINUTE=10
